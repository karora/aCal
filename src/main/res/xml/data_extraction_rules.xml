<?xml version="1.0" encoding="utf-8"?>
<!--
	Backup and device-transfer rules for Android 12 and later
	(android:dataExtractionRules).

	Neither the database nor the stored passwords can be read without keys
	that never leave the device, so none of them are backed up or transferred:
	a copy could not be opened anywhere else.  For what is on a server that
	loses nothing.  A calendar kept on the phone is in no backup, and the only
	copy of one is a file the user exports.  Keep in step with backup_rules.xml.
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="database" path="." />
		<exclude domain="sharedpref" path="acal_security.xml" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="database" path="." />
		<exclude domain="sharedpref" path="acal_security.xml" />
	</device-transfer>
</data-extraction-rules>
