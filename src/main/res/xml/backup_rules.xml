<?xml version="1.0" encoding="utf-8"?>
<!--
	Auto Backup rules for Android 7 to 11 (android:fullBackupContent).

	Neither the database nor the stored passwords can be read without keys
	that never leave the device, so none of them are backed up: a copy could
	not be opened anywhere else.  For what is on a server that loses nothing.
	A calendar kept on the phone is in no backup, and the only copy of one is
	a file the user exports.  Keep in step with data_extraction_rules.xml.
-->
<full-backup-content>
	<exclude domain="database" path="." />
	<exclude domain="sharedpref" path="acal_security.xml" />
</full-backup-content>
